name = "tonyfettes/tree_sitter"

version = "0.4.7"

import {
  "tonyfettes/tree_sitter_language@0.1.4",
  "tonyfettes/tree_sitter_moonbit@0.1.27",
  "tonyfettes/tree_sitter_json@0.1.27",
  "tonyfettes/tree_sitter_markdown@0.1.27",
  "tonyfettes/tree_sitter_yaml@0.1.27",
  "tonyfettes/tree_sitter_bash@0.1.27",
  "tonyfettes/tree_sitter_c_sharp@0.1.27",
  "tonyfettes/tree_sitter_kotlin@0.1.27",
  "tonyfettes/tree_sitter_lua@0.1.27",
  "tonyfettes/tree_sitter_toml@0.1.27",
  "tonyfettes/tree_sitter_sql@0.1.27",
  "tonyfettes/tree_sitter_zig@0.1.27",
  "tonyfettes/tree_sitter_ocaml@0.1.27",
  "tonyfettes/tree_sitter_typescript@0.1.27",
  "tonyfettes/c@0.8.0",
}

readme = "README.md"

repository = "https://github.com/tonyfettes/moonbit-tree-sitter"

license = "Apache-2.0"

keywords = [ "tree-sitter", "parser", "syntax", "highlighting" ]

description = "A MoonBit binding to the tree-sitter parsing library"

source = "src"

preferred_target = "native"

supported_targets = "native"
